{
  "expo": {
    "name": "SeedlingSpeaks",
    "slug": "seedlingspeaks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "seedlingspeaks",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0f00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seedlinglabs.speaks",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio for translation.",
        "NSCameraUsageDescription": "This app uses the camera to scan and translate text.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to translate text from images.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "seedlingspeaks"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.seedlinglabs.speaks",
      "intentFilters": [
        {
          "action": "SEND",
          "data": {
            "mimeType": "text/plain"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow SeedlingSpeaks to access your microphone for speech transcription."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SeedlingSpeaks to access your photos for Vision Translate."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
